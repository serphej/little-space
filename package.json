{
    "name":  "dashboard",
    "private":  true,
    "version":  "1.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build \u0026\u0026 node scripts/build-service-worker.mjs",
                    "lint":  "eslint .",
                    "preview":  "vite preview",
                    "test":  "node --test tests/*.test.mjs",
                    "desktop:dev":  "npm run build \u0026\u0026 electron .",
                    "desktop:start":  "electron .",
                    "desktop:dist":  "npm run build \u0026\u0026 electron-builder --win nsis --x64",
                    "desktop:test":  "npm run build \u0026\u0026 node scripts/test-desktop.mjs",
                    "desktop:test:packaged":  "node scripts/test-desktop.mjs --packaged"
                },
    "dependencies":  {
                         "react":  "^19.2.8",
                         "react-dom":  "^19.2.8"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^10.0.1",
                            "@types/react":  "^19.2.18",
                            "@types/react-dom":  "^19.2.7",
                            "@vitejs/plugin-react":  "^6.1.1",
                            "electron":  "^44.7.0",
                            "electron-builder":  "^26.15.3",
                            "eslint":  "^10.10.0",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "eslint-plugin-react-refresh":  "^0.5.6",
                            "globals":  "^17.12.0",
                            "vite":  "^8.3.0"
                        },
    "main":  "electron/main.cjs",
    "description":  "Personal task dashboard and Mochi desktop dog.",
    "author":  "Rej",
    "build":  {
                  "appId":  "com.rej.laulittlespace",
                  "productName":  "Laus Little Space",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "files":  [
                                "dist/**/*",
                                "electron/**/*",
                                "package.json"
                            ],
                  "asar":  true,
                  "npmRebuild":  false,
                  "win":  {
                              "icon":  "electron/icon.ico",
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ]
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "perMachine":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "Lau’s Little Space",
                               "deleteAppDataOnUninstall":  false,
                               "artifactName":  "Lau-Little-Space-Setup-${version}-${arch}.${ext}",
                               "include":  "electron/installer.nsh"
                           }
              }
}